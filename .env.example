# Copy to .env and fill in. .env is gitignored - never commit it.
#
# Put real values in .env, NOT in this file. This file is tracked by git, so
# anything written here is published. A test (test_env_example_has_no_filled_in_key)
# fails if a key ever appears below.
OPENAI_API_KEY=
# Model is NOT hardcoded anywhere in src/. Set it here.
OPENAI_MODEL=
